# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ticket-system?retryWrites=true&w=majority

# JWT secret for signing tokens (generate a long random string)
JWT_SECRET=your_jwt_secret_here

# Admin credentials (hardcoded login, no DB record)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here
ADMIN_EMAIL=your_email@example.com

# Brevo transactional email API key (replaces Gmail SMTP — works on Render free tier)
# Get your key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here
# Use "polling" for local dev, "webhook" for Render/production
TELEGRAM_MODE=polling

# Public base URL — used to register the Telegram webhook when TELEGRAM_MODE=webhook
# Render sets this automatically; for local dev it is not needed (polling mode)
PUBLIC_URL=https://your-app-name.onrender.com

# Cron / Daily check-in
CRON_SECRET=your_cron_secret_here
DAILY_CHECKIN_HOUR_LOCAL=21:00
