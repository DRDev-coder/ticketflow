<div class="container" style="max-width: 100%; padding-top: var(--space-6);">
  <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom: var(--space-5);">
    <div>
      <h1 style="margin:0; font-size: var(--text-2xl);">Email Inbox</h1>
      <p id="lastSyncLabel" style="margin: 4px 0 0; font-size: var(--text-sm); color: var(--color-muted);">Loading…</p>
    </div>
    <div style="display:flex; gap:10px; align-items:center;">
      <button id="reclassifyBtn" onclick="reclassifyOthers()" class="btn" style="font-size:13px; padding:8px 14px; background:rgba(99,102,241,0.15); color:#818CF8; border:1px solid rgba(99,102,241,0.35);">
        ✨ Re-classify with AI
      </button>
      <button id="syncBtn" class="btn btn--primary" style="display:flex; align-items:center; gap:6px;">
        <svg id="syncIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
          <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
        </svg>
        Sync Now
      </button>
    </div>
  </div>

  <!-- Two-panel layout -->
  <div style="display:grid; grid-template-columns: 260px 1fr; gap: var(--space-5); height: calc(100vh - 200px); min-height: 500px;">

    <!-- ── LEFT SIDEBAR: Groups ── -->
    <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-lg); overflow-y:auto; display:flex; flex-direction:column;">
      <div style="padding:var(--space-4) var(--space-4) var(--space-2); font-size:var(--text-xs); color:var(--color-muted); text-transform:uppercase; letter-spacing:0.08em; font-weight:600; border-bottom:1px solid var(--color-border); flex-shrink:0;">
        Groups
      </div>
      <div id="groupList" style="flex:1; overflow-y:auto;">
        <div style="padding:var(--space-4); color:var(--color-muted); font-size:var(--text-sm);">Loading groups…</div>
      </div>
    </div>

    <!-- ── RIGHT PANEL: Messages ── -->
    <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-lg); display:flex; flex-direction:column; overflow:hidden;">
      <!-- Panel header -->
      <div style="padding:var(--space-3) var(--space-5); border-bottom:1px solid var(--color-border); display:flex; align-items:center; justify-content:space-between; flex-shrink:0;">
        <span id="panelTitle" style="font-weight:600; font-size:var(--text-base);">Select a group</span>
        <button id="markAllReadBtn" onclick="markAllRead()" style="display:none; background:none; border:1px solid var(--color-border); color:var(--color-muted); padding:4px 12px; border-radius:var(--radius-sm); font-size:var(--text-xs); cursor:pointer;">
          Mark all read
        </button>
      </div>

      <!-- Message list -->
      <div id="messageList" style="flex:1; overflow-y:auto; padding:var(--space-3);">
        <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; color:var(--color-muted);">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity:0.3; margin-bottom:12px;">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <p style="margin:0; font-size:var(--text-sm);">Select a group from the left to view emails</p>
        </div>
      </div>

      <!-- Load more -->
      <div id="loadMoreBar" style="display:none; padding:var(--space-3); border-top:1px solid var(--color-border); text-align:center;">
        <button id="loadMoreBtn" onclick="loadMoreMessages()" class="btn" style="font-size:var(--text-sm);">Load more</button>
      </div>
    </div>
  </div>
</div>

<style>
  .group-item {
    display:flex; align-items:center; gap:10px;
    padding:10px var(--space-4);
    cursor:pointer; border-left:3px solid transparent;
    transition:background 0.15s, border-color 0.15s;
    font-size:var(--text-sm);
  }
  .group-item:hover { background:rgba(255,255,255,0.04); }
  .group-item.active { background:rgba(34,197,94,0.08); border-left-color:var(--color-primary); }
  .group-item .group-name { flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .unread-badge {
    background:var(--color-primary); color:#000;
    font-size:11px; font-weight:700;
    min-width:20px; height:20px; border-radius:10px;
    display:flex; align-items:center; justify-content:center; padding:0 6px;
  }

  .msg-card {
    border:1px solid var(--color-border); border-radius:var(--radius-md);
    margin-bottom:var(--space-2); overflow:hidden;
    transition:border-color 0.15s;
  }
  .msg-card.unread { border-left:3px solid var(--color-primary); }
  .msg-card:hover { border-color:rgba(255,255,255,0.2); }

  .msg-header {
    display:flex; align-items:center; gap:12px;
    padding:12px 16px; cursor:pointer;
  }
  .msg-avatar {
    width:36px; height:36px; border-radius:50%;
    background:linear-gradient(135deg,#22C55E,#16A34A);
    display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:14px; color:#000; flex-shrink:0;
  }
  .msg-meta { flex:1; min-width:0; }
  .msg-sender { font-size:13px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .msg-subject { font-size:12px; color:var(--color-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .msg-preview { font-size:11px; color:var(--color-muted); margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .msg-time { font-size:11px; color:var(--color-muted); flex-shrink:0; }

  .msg-body-wrap { display:none; border-top:1px solid var(--color-border); background:rgba(0,0,0,0.15); }
  .msg-body-wrap.open { display:block; }

  .msg-body-text {
    padding:14px 16px 14px 64px;
    font-size:13px; line-height:1.7; color:#CBD5E1;
    white-space:pre-wrap; word-break:break-word;
  }

  /* Move to group bar */
  .msg-move-bar {
    display:flex; align-items:center; gap:10px;
    padding:8px 16px 8px 64px;
    border-top:1px solid var(--color-border);
    background:rgba(0,0,0,0.08);
    font-size:12px;
  }
  .msg-move-bar select {
    background:var(--color-bg); border:1px solid var(--color-border);
    color:var(--color-text); padding:4px 8px; border-radius:var(--radius-sm);
    font-size:12px; cursor:pointer;
  }

  /* Reply compose */
  .msg-reply-wrap {
    padding:12px 16px 12px 64px;
    border-top:1px solid var(--color-border);
    background:rgba(0,0,0,0.08);
  }
  .msg-reply-to { font-size:11px; color:var(--color-muted); margin-bottom:6px; }
  .msg-reply-textarea {
    width:100%; box-sizing:border-box;
    background:var(--color-bg); border:1px solid var(--color-border);
    color:var(--color-text); border-radius:var(--radius-md);
    padding:10px 12px; font-size:13px; line-height:1.6;
    resize:vertical; min-height:90px; font-family:inherit;
    transition:border-color 0.2s;
  }
  .msg-reply-textarea:focus { outline:none; border-color:var(--color-primary); }
  .msg-reply-actions { display:flex; gap:8px; margin-top:8px; }

  @keyframes spin { to { transform:rotate(360deg); } }
  .spinning { animation:spin 0.8s linear infinite; }
</style>

<script>
  // ─── State ────────────────────────────────────────────────────────────────────
  let activeGroupId = null;
  let currentPage   = 1;
  let totalMessages = 0;
  let allProblems   = [];   // loaded once for the "Move to" dropdowns
  const PAGE_SIZE   = 30;

  // ─── Helpers ─────────────────────────────────────────────────────────────────
  function timeAgo(d) {
    const diff = Date.now() - new Date(d).getTime();
    const m = Math.floor(diff/60000), h = Math.floor(diff/3600000), dy = Math.floor(diff/86400000);
    if (m < 1) return 'just now';
    if (m < 60) return `${m}m ago`;
    if (h < 24) return `${h}h ago`;
    if (dy < 7) return `${dy}d ago`;
    return new Date(d).toLocaleDateString('en-IN',{day:'numeric',month:'short'});
  }
  function esc(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function escAttr(s) { return String(s||'').replace(/'/g,'&#39;').replace(/"/g,'&quot;'); }

  // ─── Load problems (for Move-to dropdowns) ────────────────────────────────────
  async function loadProblems() {
    try {
      const res  = await fetch('/api/admin/problems');
      const data = await res.json();
      allProblems = data || [];
    } catch (_) {}
  }

  function moveOptions(currentProblemId) {
    const opts = allProblems.map(p => {
      const sel = currentProblemId && p._id === currentProblemId ? 'selected' : '';
      return `<option value="${esc(p._id)}" ${sel}>${esc(p.name)}</option>`;
    });
    const selOthers = !currentProblemId ? 'selected' : '';
    return `<option value="null" ${selOthers}>Others</option>${opts.join('')}`;
  }

  // ─── Load groups (sidebar) ────────────────────────────────────────────────────
  async function loadGroups() {
    try {
      const res  = await fetch('/api/admin/inbox/groups');
      const data = await res.json();

      document.getElementById('lastSyncLabel').textContent =
        data.lastSyncedAt ? `Last synced ${timeAgo(data.lastSyncedAt)}` : 'Not synced yet — click Sync Now';

      const list = document.getElementById('groupList');
      if (!data.groups || data.groups.length === 0) {
        list.innerHTML = '<div style="padding:16px;font-size:13px;color:var(--color-muted);">No groups yet. Add a problem category first.</div>';
        return;
      }

      list.innerHTML = data.groups.map(g => {
        const gid   = g._id ? String(g._id) : 'null';
        const badge = g.unread > 0
          ? `<span class="unread-badge">${g.unread}</span>`
          : `<span style="font-size:11px;color:var(--color-muted);">${g.total}</span>`;
        const muted = g.isOthers ? 'color:var(--color-muted);font-style:italic;' : '';
        const act   = (activeGroupId === null && gid === 'null') || gid === String(activeGroupId) ? 'active' : '';
        return `<div class="group-item ${act}" onclick="selectGroup('${gid}','${escAttr(g.name)}')" data-gid="${gid}">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.4;flex-shrink:0;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span class="group-name" style="${muted}">${esc(g.name)}</span>
          ${badge}
        </div>`;
      }).join('');

      // Update nav unread dot
      const dot = document.getElementById('inboxUnreadDot');
      if (dot) dot.style.display = data.groups.reduce((s,g)=>s+g.unread,0) > 0 ? 'inline-block' : 'none';

    } catch (_) {}
  }

  // ─── Select group ─────────────────────────────────────────────────────────────
  function selectGroup(gid, name) {
    activeGroupId = gid === 'null' ? null : gid;
    currentPage   = 1;
    totalMessages = 0;
    document.querySelectorAll('.group-item').forEach(el =>
      el.classList.toggle('active', el.dataset.gid === gid));
    document.getElementById('panelTitle').textContent = name;
    document.getElementById('markAllReadBtn').style.display = 'inline-block';
    document.getElementById('messageList').innerHTML =
      '<div style="padding:2rem;text-align:center;color:var(--color-muted);font-size:13px;">Loading…</div>';
    document.getElementById('loadMoreBar').style.display = 'none';
    loadMessages(false);
  }

  // ─── Load messages ────────────────────────────────────────────────────────────
  async function loadMessages(append = false) {
    const pid = activeGroupId === null ? 'null' : activeGroupId;
    try {
      const res  = await fetch(`/api/admin/inbox/messages?problemId=${pid}&page=${currentPage}&limit=${PAGE_SIZE}`);
      const data = await res.json();
      totalMessages = data.total;
      const list = document.getElementById('messageList');

      if (!append) {
        if (!data.messages || data.messages.length === 0) {
          list.innerHTML = `<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:var(--color-muted);padding:2rem;text-align:center;">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity:0.3;margin-bottom:10px;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <p style="margin:0;font-size:13px;">No emails in this group yet.</p>
          </div>`;
          document.getElementById('loadMoreBar').style.display = 'none';
          return;
        }
        list.innerHTML = '';
      }

      data.messages.forEach(msg => list.insertAdjacentHTML('beforeend', renderMessage(msg)));

      const shown = (currentPage - 1) * PAGE_SIZE + data.messages.length;
      document.getElementById('loadMoreBar').style.display = shown < totalMessages ? 'block' : 'none';
    } catch (_) {}
  }

  function loadMoreMessages() { currentPage++; loadMessages(true); }

  // ─── Render message card ─────────────────────────────────────────────────────
  function renderMessage(msg) {
    const preview = (msg.bodyText || '').substring(0, 120).replace(/\n/g, ' ');
    const fullText = esc(msg.bodyText || '(empty)');
    const from     = esc(msg.from || msg.fromEmail || 'Unknown');
    const avatar   = (msg.from || msg.fromEmail || '?').trim().charAt(0).toUpperCase();
    const pid      = msg.problemId ? String(msg.problemId) : null;

    return `<div class="msg-card ${msg.isRead ? '' : 'unread'}" id="msg-${msg._id}">
      <!-- Header (click to expand) -->
      <div class="msg-header" onclick="toggleMsg('${msg._id}')">
        <div class="msg-avatar">${avatar}</div>
        <div class="msg-meta">
          <div class="msg-sender">${from}</div>
          <div class="msg-subject">${esc(msg.subject)}</div>
          <div class="msg-preview">${esc(preview)}…</div>
        </div>
        <div class="msg-time">${timeAgo(msg.receivedAt)}</div>
      </div>

      <!-- Expandable body -->
      <div class="msg-body-wrap" id="body-${msg._id}">
        <!-- Meta row -->
        <div style="padding:10px 16px 6px 64px; font-size:11px; color:var(--color-muted); border-bottom:1px solid var(--color-border);">
          From: <strong style="color:#94A3B8;">${from}</strong> &nbsp;|&nbsp;
          ${new Date(msg.receivedAt).toLocaleString('en-IN',{dateStyle:'medium',timeStyle:'short',timeZone:'Asia/Kolkata'})}
        </div>

        <!-- Full body text -->
        <div class="msg-body-text">${fullText}</div>

        <!-- Move to group -->
        <div class="msg-move-bar">
          <span style="color:var(--color-muted);">Move to group:</span>
          <select id="move-${msg._id}" onchange="moveMsg('${msg._id}', this.value)">
            ${moveOptions(pid)}
          </select>
        </div>

        <!-- Reply compose -->
        <div class="msg-reply-wrap">
          <div class="msg-reply-to">↩ Replying to <strong>${esc(msg.fromEmail)}</strong></div>
          <textarea class="msg-reply-textarea" id="reply-${msg._id}" placeholder="Type your reply here…"></textarea>
          <div class="msg-reply-actions">
            <button class="btn btn--primary" style="font-size:12px; padding:6px 16px;" onclick="sendReply('${msg._id}')">
              Send Reply
            </button>
            <span id="reply-status-${msg._id}" style="font-size:12px; color:var(--color-muted); align-self:center;"></span>
          </div>
        </div>
      </div>
    </div>`;
  }

  // ─── Toggle expand / mark read ────────────────────────────────────────────────
  function toggleMsg(id) {
    const body = document.getElementById(`body-${id}`);
    const card = document.getElementById(`msg-${id}`);
    body.classList.toggle('open');
    if (body.classList.contains('open') && card.classList.contains('unread')) {
      card.classList.remove('unread');
      fetch(`/api/admin/inbox/messages/${id}/read`, { method: 'PATCH' });
      loadGroups();
    }
  }

  // ─── Send reply ───────────────────────────────────────────────────────────────
  async function sendReply(id) {
    const ta     = document.getElementById(`reply-${id}`);
    const status = document.getElementById(`reply-status-${id}`);
    if (!ta.value.trim()) { status.textContent = 'Please type a reply first.'; return; }

    status.textContent = 'Sending…';
    try {
      const res  = await fetch(`/api/admin/inbox/messages/${id}/reply`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ body: ta.value.trim() })
      });
      const data = await res.json();
      if (res.ok) {
        status.style.color = '#4ade80';
        status.textContent = '✓ ' + (data.message || 'Reply sent!');
        ta.value = '';
        setTimeout(() => { status.textContent = ''; status.style.color = 'var(--color-muted)'; }, 3000);
      } else {
        status.style.color = '#f87171';
        status.textContent = data.error || 'Failed to send.';
      }
    } catch {
      status.style.color = '#f87171';
      status.textContent = 'Network error.';
    }
  }

  // ─── Move to group ────────────────────────────────────────────────────────────
  async function moveMsg(id, problemId) {
    try {
      const res  = await fetch(`/api/admin/inbox/messages/${id}/move`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ problemId: problemId === 'null' ? null : problemId })
      });
      const data = await res.json();
      if (res.ok) {
        showAlert(`Moved to "${data.problemName}"`, 'success');
        // Remove from current view after a short delay
        setTimeout(() => {
          const card = document.getElementById(`msg-${id}`);
          if (card) card.style.opacity = '0.3';
        }, 500);
        loadGroups();
      } else {
        showAlert(data.error || 'Failed to move', 'error');
      }
    } catch { showAlert('Network error', 'error'); }
  }

  // ─── Mark all read ────────────────────────────────────────────────────────────
  async function markAllRead() {
    const pid = activeGroupId === null ? 'null' : (activeGroupId || 'null');
    await fetch(`/api/admin/inbox/groups/read-all?problemId=${pid}`, { method: 'PATCH' });
    document.querySelectorAll('.msg-card.unread').forEach(el => el.classList.remove('unread'));
    loadGroups();
    showAlert('All messages marked as read', 'success');
  }

  // ─── Re-classify with AI ─────────────────────────────────────────────────────
  async function reclassifyOthers() {
    const btn = document.getElementById('reclassifyBtn');
    btn.disabled = true;
    btn.textContent = '✨ Classifying…';
    try {
      const res  = await fetch('/api/admin/inbox/reclassify', { method: 'POST', headers: {'Content-Type':'application/json'}, body: '{}' });
      const data = await res.json();
      if (res.ok) {
        showAlert(data.message || 'Done!', 'success');
        await loadGroups();
        if (activeGroupId !== undefined) { currentPage = 1; loadMessages(false); }
      } else {
        showAlert(data.error || 'Re-classify failed', 'error');
      }
    } catch { showAlert('Network error', 'error'); }
    finally { btn.disabled = false; btn.textContent = '✨ Re-classify with AI'; }
  }

  // ─── Sync button ──────────────────────────────────────────────────────────────
  document.getElementById('syncBtn').addEventListener('click', async () => {
    const btn  = document.getElementById('syncBtn');
    const icon = document.getElementById('syncIcon');
    btn.disabled = true; icon.classList.add('spinning');
    try {
      const res  = await fetch('/api/admin/inbox/sync', { method: 'POST' });
      const data = await res.json();
      if (res.ok) {
        showAlert(`Sync complete: ${data.newEmails} new email(s)`, 'success');
        await loadGroups();
        if (activeGroupId !== undefined) { currentPage = 1; loadMessages(false); }
      } else { showAlert(data.error || 'Sync failed', 'error'); }
    } catch { showAlert('Network error during sync', 'error'); }
    finally { btn.disabled = false; icon.classList.remove('spinning'); }
  });

  // ─── Init ─────────────────────────────────────────────────────────────────────
  (async () => {
    await loadProblems();
    await loadGroups();
    setInterval(loadGroups, 120_000);
  })();
</script>
