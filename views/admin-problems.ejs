<div class="container">
  <div class="page-header">
    <h1>Problem Management</h1>
    <button class="btn btn--primary" onclick="openAddModal()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Problem
    </button>
  </div>

  <!-- Stats -->
  <div class="stats-grid" id="statsGrid">
    <div class="stat-card">
      <div class="stat-card__value" id="totalProblems">-</div>
      <div class="stat-card__label">Total Problems</div>
    </div>
    <div class="stat-card">
      <div class="stat-card__value" id="activeProblems">-</div>
      <div class="stat-card__label">Active</div>
    </div>
    <div class="stat-card">
      <div class="stat-card__value" id="inactiveProblems">-</div>
      <div class="stat-card__label">Inactive</div>
    </div>
    <div class="stat-card">
      <div class="stat-card__value" id="totalTicketsCount">-</div>
      <div class="stat-card__label">Total Tickets</div>
    </div>
  </div>

  <!-- Problems Table -->
  <div class="table-wrapper" id="problemsTable">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Assigned Email</th>
          <th>Telegram Recipient</th>
          <th>Status</th>
          <th>Tickets</th>
          <th>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="problemsBody">
        <tr>
          <td colspan="7" class="text-center text-muted" style="padding: 2rem;">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal-overlay" id="problemModal">
  <div class="modal">
    <div class="modal__header">
      <h3 id="modalTitle">Add Problem</h3>
      <button class="modal__close" onclick="closeModal()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="problemForm">
      <input type="hidden" id="editId" value="">
      <div class="form-group">
        <label for="problemName">Problem Name</label>
        <input type="text" id="problemName" class="form-control" placeholder="e.g. Login Issue" required>
      </div>
      <div class="form-group">
        <label for="assignedEmail">Assigned Email</label>
        <input type="email" id="assignedEmail" class="form-control" placeholder="destination@example.com" required>
        <div class="text-xs text-muted mt-2" id="recipientStatus" style="min-height:1.2em;"></div>
      </div>

      <!-- Telegram Chat ID field — shown once assignedEmail is filled -->
      <div class="form-group" id="telegramGroup" style="display:none;">
        <label for="telegramChatId" style="display:flex;align-items:center;gap:var(--space-2);">
          Telegram Chat ID
          <span id="telegramBadge" class="text-xs" style="font-weight:400;"></span>
        </label>
        <input
          type="text"
          id="telegramChatId"
          class="form-control font-mono"
          placeholder="e.g. 8548817278"
          inputmode="numeric"
        >
        <div class="text-xs text-muted mt-2" id="recipientLabel"></div>
      </div>

      <div style="display: flex; gap: var(--space-3); justify-content: flex-end; margin-top: var(--space-4);">
        <button type="button" class="btn btn--secondary" onclick="closeModal()">Cancel</button>
        <button type="submit" class="btn btn--primary" id="modalSubmitBtn">Add Problem</button>
      </div>
    </form>
  </div>
</div>

<script>
  let problems = [];
  let recipientLookupTimer = null;

  // Fetch and render problems
  async function loadProblems() {
    try {
      const res = await fetch('/api/admin/problems', { credentials: 'same-origin' });
      if (!res.ok) throw new Error('Failed to fetch');
      problems = await res.json();

      // Enrich with recipient info for each unique assignedEmail
      const emails = [...new Set(problems.map(p => p.assignedEmail))];
      const recipientMap = {};
      await Promise.all(emails.map(async (email) => {
        try {
          const r = await fetch(`/api/admin/recipients?email=${encodeURIComponent(email)}`, { credentials: 'same-origin' });
          if (r.ok) { recipientMap[email] = await r.json(); }
        } catch {}
      }));

      renderProblems(recipientMap);
      updateStats();
    } catch (err) {
      document.getElementById('problemsBody').innerHTML =
        '<tr><td colspan="7" class="text-center text-muted" style="padding:2rem;">Failed to load problems</td></tr>';
    }
  }

  function renderProblems(recipientMap = {}) {
    const tbody = document.getElementById('problemsBody');
    if (problems.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted" style="padding:2rem;">No problems found. Click "Add Problem" to create one.</td></tr>';
      return;
    }
    tbody.innerHTML = problems.map(p => {
      const rec = recipientMap[p.assignedEmail];
      let telegramCell;
      if (!rec || !rec.found) {
        telegramCell = '<span class="badge badge--inactive">No recipient</span>';
      } else if (!rec.telegramChatId) {
        telegramCell = `<span class="text-xs text-muted">${escapeHtml(rec.label || rec.email)}<br><em>No Chat ID</em></span>`;
      } else {
        telegramCell = `<span class="text-xs">${escapeHtml(rec.label || rec.email)}<br><span class="font-mono" style="color:var(--color-accent)">${escapeHtml(rec.telegramChatId)}</span></span>`;
      }
      return `
        <tr>
          <td style="font-weight:500;">${escapeHtml(p.name)}</td>
          <td><span class="font-mono text-sm">${escapeHtml(p.assignedEmail)}</span></td>
          <td>${telegramCell}</td>
          <td>
            <span class="badge badge--${p.isActive ? 'active' : 'inactive'}">
              ${p.isActive ? 'Active' : 'Inactive'}
            </span>
          </td>
          <td><span class="font-mono">${p.ticketCount}</span></td>
          <td class="text-muted text-sm">${new Date(p.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</td>
          <td>
            <div style="display:flex;gap:var(--space-2);">
              <button class="btn btn--secondary btn--sm" onclick="openEditModal('${p._id}')">Edit</button>
              <button class="btn btn--sm ${p.isActive ? 'btn--danger' : 'btn--primary'}" onclick="toggleActive('${p._id}', ${!p.isActive})">
                ${p.isActive ? 'Disable' : 'Enable'}
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  function updateStats() {
    const active = problems.filter(p => p.isActive).length;
    const inactive = problems.length - active;
    const totalTickets = problems.reduce((sum, p) => sum + p.ticketCount, 0);
    document.getElementById('totalProblems').textContent = problems.length;
    document.getElementById('activeProblems').textContent = active;
    document.getElementById('inactiveProblems').textContent = inactive;
    document.getElementById('totalTicketsCount').textContent = totalTickets;
  }

  // --- Recipient lookup (debounced) ---
  async function lookupRecipient(email) {
    const statusEl = document.getElementById('recipientStatus');
    const groupEl = document.getElementById('telegramGroup');
    const chatIdEl = document.getElementById('telegramChatId');
    const badgeEl = document.getElementById('telegramBadge');
    const labelEl = document.getElementById('recipientLabel');

    if (!email || !/^\S+@\S+\.\S+$/.test(email)) {
      groupEl.style.display = 'none';
      statusEl.textContent = '';
      return;
    }

    statusEl.textContent = 'Looking up recipient…';
    statusEl.style.color = 'var(--color-muted)';

    try {
      const res = await fetch(`/api/admin/recipients?email=${encodeURIComponent(email)}`, { credentials: 'same-origin' });
      const data = await res.json();

      groupEl.style.display = 'block';

      if (!data.found) {
        statusEl.textContent = '⚠ No recipient record yet — fill in Chat ID below to create one.';
        statusEl.style.color = '#F59E0B';
        chatIdEl.value = '';
        badgeEl.textContent = '(new)';
        badgeEl.style.color = '#F59E0B';
        labelEl.textContent = '';
      } else {
        statusEl.textContent = `✓ Recipient found: ${data.label || data.email}`;
        statusEl.style.color = 'var(--color-accent)';
        chatIdEl.value = data.telegramChatId || '';
        badgeEl.textContent = data.telegramChatId ? '' : '(no Chat ID yet)';
        badgeEl.style.color = '#F59E0B';
        labelEl.textContent = data.label ? `Label: ${data.label}` : '';
      }
    } catch (err) {
      statusEl.textContent = 'Could not look up recipient.';
      statusEl.style.color = '#F87171';
    }
  }

  // Wire debounce to the assignedEmail field
  document.getElementById('assignedEmail').addEventListener('input', (e) => {
    clearTimeout(recipientLookupTimer);
    recipientLookupTimer = setTimeout(() => lookupRecipient(e.target.value.trim()), 600);
  });

  // --- Modals ---
  function openAddModal() {
    document.getElementById('modalTitle').textContent = 'Add Problem';
    document.getElementById('modalSubmitBtn').textContent = 'Add Problem';
    document.getElementById('editId').value = '';
    document.getElementById('problemName').value = '';
    document.getElementById('assignedEmail').value = '';
    document.getElementById('telegramChatId').value = '';
    document.getElementById('telegramGroup').style.display = 'none';
    document.getElementById('recipientStatus').textContent = '';
    document.getElementById('problemModal').classList.add('active');
  }

  function openEditModal(id) {
    const p = problems.find(x => x._id === id);
    if (!p) return;
    document.getElementById('modalTitle').textContent = 'Edit Problem';
    document.getElementById('modalSubmitBtn').textContent = 'Save Changes';
    document.getElementById('editId').value = id;
    document.getElementById('problemName').value = p.name;
    document.getElementById('assignedEmail').value = p.assignedEmail;
    document.getElementById('telegramGroup').style.display = 'none';
    document.getElementById('recipientStatus').textContent = '';
    document.getElementById('problemModal').classList.add('active');
    // Trigger recipient lookup immediately
    lookupRecipient(p.assignedEmail);
  }

  function closeModal() {
    document.getElementById('problemModal').classList.remove('active');
  }

  // --- Form submit ---
  document.getElementById('problemForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('modalSubmitBtn');
    const editId = document.getElementById('editId').value;
    const assignedEmail = document.getElementById('assignedEmail').value.trim();
    const telegramChatId = document.getElementById('telegramChatId').value.trim();

    const problemData = {
      name: document.getElementById('problemName').value.trim(),
      assignedEmail
    };

    const url = editId ? `/api/admin/problems/${editId}` : '/api/admin/problems';
    const method = editId ? 'PATCH' : 'POST';

    const result = await submitForm(url, problemData, {
      method,
      button: btn,
      successMessage: editId ? 'Problem updated!' : 'Problem created!'
    });

    if (result) {
      // Also upsert the Recipient record with whatever Chat ID was entered
      if (telegramChatId !== '') {
        try {
          await fetch('/api/admin/recipients', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ email: assignedEmail, telegramChatId })
          });
        } catch (err) {
          console.warn('Could not save recipient Chat ID:', err);
        }
      }
      closeModal();
      loadProblems();
    }
  });

  // Toggle active/inactive
  async function toggleActive(id, isActive) {
    const result = await submitForm(`/api/admin/problems/${id}`, { isActive }, { method: 'PATCH' });
    if (result) {
      showAlert(isActive ? 'Problem enabled' : 'Problem disabled', 'success');
      loadProblems();
    }
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  document.getElementById('problemModal').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  loadProblems();
</script>
